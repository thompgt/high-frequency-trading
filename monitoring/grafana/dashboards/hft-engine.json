{
  "uid": "hft-engine",
  "title": "HFT Engine",
  "description": "Live view of the Python market-data / signal / paper-execution pipeline. Provisioned from monitoring/grafana/dashboards/hft-engine.json.",
  "tags": [
    "hft",
    "trading",
    "latency"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "hft-prometheus"
        },
        "query": "label_values(hft_ticks_ingested_total, symbol)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pipeline",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"hft-engine\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Prometheus scrape status of the Python exporter (port 9101)."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ticks / sec",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 3,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(hft_ticks_ingested_total[$__rate_interval]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Market-data events pushed into the ring buffer, all symbols."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Signals / min",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 7,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "60 * sum(rate(hft_signals_total[$__rate_interval]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Crossover signals emitted by the strategy. Zero is normal on a quiet tape."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Realized P&L",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 11,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "hft_realized_pnl",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Paper venue realized P&L, net of modelled slippage and fees."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Order reject rate",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(hft_orders_rejected_total[$__rate_interval])) / clamp_min(sum(rate(hft_orders_submitted_total[$__rate_interval])), 0.0001)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Rejected orders as a share of submitted. The paper venue fills everything, so anything above zero means the venue raised."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "p99 ingest to signal",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hft_ingest_to_signal_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 6,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Tail time from tick ingest to the strategy starting work. Buffer backlog shows up here first."
    },
    {
      "id": 7,
      "type": "row",
      "title": "Market data & signals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tick ingest rate by symbol",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (symbol) (rate(hft_ticks_ingested_total{symbol=~\"$symbol\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{symbol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "ops",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Throughput of the ingest loop. A flat line at zero with the pipeline UP means the feed stopped yielding."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Signal rate by side",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "60 * sum by (side) (rate(hft_signals_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{side}}"
        },
        {
          "expr": "sum(hft_signals_total)",
          "refId": "B",
          "legendFormat": "cumulative signals"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "BUY"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SELL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "cumulative signals"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    1,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Signals per minute split by side (left axis) against the running total (right axis)."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Buffer depth, drops & feed errors",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "hft_buffer_depth",
          "refId": "A",
          "legendFormat": "buffer depth"
        },
        {
          "expr": "sum(rate(hft_ticks_dropped_total[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "dropped ticks/s"
        },
        {
          "expr": "sum by (reason) (rate(hft_feed_errors_total[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "feed error: {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dropped ticks/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "feed error: .*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Ring buffer occupancy plus the two ways ticks go missing: overflow drops (engine too slow) and upstream poll failures."
    },
    {
      "id": 11,
      "type": "row",
      "title": "Execution & P&L",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Order outcomes",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "60 * sum(rate(hft_orders_submitted_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "submitted"
        },
        {
          "expr": "60 * sum(rate(hft_orders_filled_total[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "filled"
        },
        {
          "expr": "60 * sum(rate(hft_orders_rejected_total[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "submitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "filled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Orders per minute at each stage. Submitted above filled means the venue is rejecting."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Rejects by reason",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(hft_orders_rejected_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        },
        {
          "expr": "sum by (reason) (hft_orders_rejected_total)",
          "refId": "B",
          "legendFormat": "{{reason}} total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "ops",
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    1,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Reject reasons are exception type names from the execution venue -- a bounded label set. Empty panel = no rejects, which is the healthy case for the paper venue."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Realized P&L & position",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "hft_realized_pnl",
          "refId": "A",
          "legendFormat": "realized P&L"
        },
        {
          "expr": "hft_position_quantity{symbol=~\"$symbol\"}",
          "refId": "B",
          "legendFormat": "{{symbol}} position"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "realized P&L"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* position"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Cumulative realized P&L (left, USD) against signed open position per symbol (right). Position steps are the trades that moved P&L."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Fills & filled quantity by side",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hft-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (side) (hft_orders_filled_total)",
          "refId": "A",
          "legendFormat": "{{side}} fills"
        },
        {
          "expr": "sum by (side) (hft_filled_quantity_total)",
          "refId": "B",
          "legendFormat": "{{side}} shares"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "BUY fills"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SELL fills"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* shares"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
